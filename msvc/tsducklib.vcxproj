<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{B4C5D6E7-F8A9-4B0C-9D1E-2F3A4B5C6D7E}</ProjectGuid>
    <Keyword>MakeFileProj</Keyword>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>Makefile</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Makefile</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <_TSDuckScriptsDir>$([System.IO.Path]::GetFullPath('$(SolutionDir)..\thirdparty\tsduck\scripts\msvc\'))</_TSDuckScriptsDir>
    <_TSDuckLibOut>$([System.IO.Path]::GetFullPath('$(SolutionDir)..\thirdparty\tsduck\bin\$(Configuration)-$(Platform)\tsducklib.lib'))</_TSDuckLibOut>
    <_TSDuckDir>$([System.IO.Path]::GetFullPath('$(SolutionDir)..\thirdparty\tsduck'))</_TSDuckDir>
    <_TSDuckStamp>$([System.IO.Path]::GetFullPath('$(SolutionDir)..\thirdparty\tsduck\bin\$(Configuration)-$(Platform)\tsducklib.commit'))</_TSDuckStamp>
    <!-- Build only if the output lib is missing; never clean tsduck artifacts.
         InvalidateStaleTSDuckLib below removes the library when the TSDuck
         revision it was built from no longer matches the checked-out one. -->
    <_OverrideProps>$([System.IO.Path]::GetFullPath('$(SolutionDir)override-utf8.props'))</_OverrideProps>
    <_BuildCmd>if not exist "$(_TSDuckLibOut)" "$(MSBuildBinPath)\MSBuild.exe" "$(_TSDuckScriptsDir)tsducklib.vcxproj" /p:Configuration=$(Configuration);Platform=$(Platform);PlatformToolset=v143 "/p:ForceImportBeforeCppTargets=$(_OverrideProps)" /m</_BuildCmd>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <NMakeBuildCommandLine>$(_BuildCmd)</NMakeBuildCommandLine>
    <NMakeReBuildCommandLine>$(_BuildCmd)</NMakeReBuildCommandLine>
    <NMakeCleanCommandLine>echo tsducklib: skipping clean (managed separately)</NMakeCleanCommandLine>
    <NMakeOutput>$(_TSDuckLibOut)</NMakeOutput>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <NMakeBuildCommandLine>$(_BuildCmd)</NMakeBuildCommandLine>
    <NMakeReBuildCommandLine>$(_BuildCmd)</NMakeReBuildCommandLine>
    <NMakeCleanCommandLine>echo tsducklib: skipping clean (managed separately)</NMakeCleanCommandLine>
    <NMakeOutput>$(_TSDuckLibOut)</NMakeOutput>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <!-- The build command only runs when the output library is missing, so after a
       TSDuck submodule update an existing checkout keeps linking a library built
       from the previous revision against the new headers - silently, until it
       fails at link time or misbehaves at runtime. Stamp the TSDuck commit next
       to the library and drop the library when the two disagree.

       A missing stamp counts as a mismatch: the library predates this check, so
       the revision it came from is unknown. That costs one rebuild per existing
       checkout. -->
  <Target Name="InvalidateStaleTSDuckLib" BeforeTargets="Build">
    <Exec Command="git -C &quot;$(_TSDuckDir)&quot; rev-parse HEAD"
          ConsoleToMSBuild="true"
          ContinueOnError="true"
          EchoOff="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_TSDuckCommit" />
      <Output TaskParameter="ExitCode" PropertyName="_TSDuckGitExitCode" />
    </Exec>

    <ReadLinesFromFile File="$(_TSDuckStamp)" Condition="Exists('$(_TSDuckStamp)')">
      <Output TaskParameter="Lines" PropertyName="_TSDuckStampCommit" />
    </ReadLinesFromFile>

    <!-- Without a working git there is nothing to compare against, so leave the
         existing library alone rather than forcing a rebuild on every build. -->
    <PropertyGroup>
      <_TSDuckLibIsStale Condition="'$(_TSDuckGitExitCode)'=='0' and '$(_TSDuckCommit)'!='' and '$(_TSDuckCommit)'!='$(_TSDuckStampCommit)'">true</_TSDuckLibIsStale>
    </PropertyGroup>

    <Message Condition="'$(_TSDuckLibIsStale)'=='true' and Exists('$(_TSDuckLibOut)')"
             Importance="high"
             Text="tsducklib: TSDuck revision changed ('$(_TSDuckStampCommit)' -> '$(_TSDuckCommit)'); discarding the stale static library" />
    <Delete Files="$(_TSDuckLibOut)" Condition="'$(_TSDuckLibIsStale)'=='true'" />
  </Target>

  <Target Name="RecordTSDuckRevision" AfterTargets="Build"
          Condition="'$(_TSDuckCommit)'!='' and Exists('$(_TSDuckLibOut)')">
    <WriteLinesToFile File="$(_TSDuckStamp)" Lines="$(_TSDuckCommit)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
