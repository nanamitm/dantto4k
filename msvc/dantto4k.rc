#include <winver.h>
#include "../src/resource.h"
// Written by tools/generate-version-header.ps1 from a pre-build step.
#include "../src/dantto4kVersion.h"

// Generated by generate-tsduck-names.ps1 from a pre-build step. See
// src/tsduckNames.h for what it is and why it travels inside the binary.
IDR_TSDUCK_DTV_NAMES RCDATA "generated\\tsduck.dtv.names"

// The version this build comes from (git describe), shown in the file's
// properties. dantto4k.exe and BonDriver_dantto4k.dll share it.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION DANTTO4K_VERSION_NUMBERS
 PRODUCTVERSION DANTTO4K_VERSION_NUMBERS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_UNKNOWN
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "dantto4k (MMT/TLV to MPEG-2 TS converter)"
            VALUE "FileVersion", DANTTO4K_VERSION_STRING
            VALUE "ProductName", "dantto4k"
            VALUE "ProductVersion", DANTTO4K_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
