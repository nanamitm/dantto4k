<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Makes UTF-8 the process's ANSI code page (Windows 10 1903 and later), so
     argv, std::ifstream and std::filesystem take any file name - a programme
     title with a character outside CP932 such as U+301C could not be opened.
     Earlier Windows ignores this and keeps the system code page. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
